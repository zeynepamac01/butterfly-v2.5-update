                    "type": "linkpath",
                    "shape": {
                        "signal": "links"
                    },
                    "orient": "horizontal",
                    "sourceX": "source.y",
                    "sourceY": "source.x",
                    "targetX": "target.y",
                    "targetY": "target.x"
                }
            ]
