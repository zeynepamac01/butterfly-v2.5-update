            "transform": [
                {
                    "type": "stratify",
                    "key": "id",
                    "parentKey": "parent"
                },
                {
                    "type": "tree",
                    "method": {
                        "signal": "layout"
                    },
                    "size": [
                        1,
                        {
                            "signal": "radius"
                        }
                    ],
                    "as": [
                        "alpha",
                        "radius",
                        "depth",
                        "children"
                    ]
                },
                {
                    "type": "formula",
                    "expr": "(rotate + extent * datum.alpha + 270) % 360",
                    "as": "angle"
                },
                {
                    "type": "formula",
                    "expr": "PI * datum.angle / 180",
                    "as": "radians"
                },
                {
                    "type": "formula",
                    "expr": "inrange(datum.angle, [90, 270])",
                    "as": "leftside"
                },
                {
                    "type": "formula",
                    "expr": "originX + datum.radius * cos(datum.radians)",
                    "as": "x"
                },
                {
                    "type": "formula",
                    "expr": "originY + datum.radius * sin(datum.radians)",
                    "as": "y"
                }
            ]
        },
        {
            "name": "links",
            "source": "tree",
            "transform": [
                {
                    "type": "treelinks"
                },
                {
                    "type": "linkpath",
                    "shape": {
                        "signal": "links"
                    },
                    "orient": "radial",
                    "sourceX": "source.radians",
                    "sourceY": "source.radius",
                    "targetX": "target.radians",
                    "targetY": "target.radius"
                }
            ]
        }
    ],
    "marks": [
        {
            "type": "path",
            "from": {
                "data": "links"
            },
            "encode": {
                "update": {
                    "x": {
                        "signal": "originX"
                    },
                    "y": {
                        "signal": "originY"
                    },
                    "path": {
                        "field": "path"
                    },
                    "stroke": {
                        "value": "#ccc"
                    },
                    "opacity": {
                        "value": 0.7
                    },
                    "strokeWidth": {
                        "value": 0.5
                    }
                }
            }
        },
        {
            "type": "symbol",
            "from": {
                "data": "tree"
            },
            "encode": {
                "enter": {
                    "size": {
                        "value": 12
                    },
                    "stroke": {
                        "value": "#fff"
                    },
                    "strokeWidth": {
                        "value": 0.2
                    }
                },
                "update": {
                    "x": {
                        "field": "x"
                    },
                    "y": {
                        "field": "y"
                    },
                    "fill": {
                        "field": "color"
                    },
                    "opacity": {
                        "value": 0.3
                    }
                }
            }
        },
        {
            "type": "text",
            "from": {
                "data": "tree"
            },
            "encode": {
                "enter": {
                    "text": {
                        "field": "name"
                    },
                    "fontSize": {
                        "value": 8
                    },
                    "font": {
                        "value": "Benton Sans Book"
                    },
                    "baseline": {
                        "value": "middle"
                    }
                },
                "update": {
                    "x": {
                        "field": "x"
                    },
                    "y": {
                        "field": "y"
                    },
                    "dx": {
                        "signal": "(datum.leftside ? -1 : 1) * 6"
                    },
                    "angle": {
                        "signal": "datum.leftside ? datum.angle - 180 : datum.angle"
                    },
                    "align": {
                        "signal": "datum.leftside ? 'right' : 'left'"
                    },
                    "opacity": {
                        "signal": "labels ? 0.5 : 1"
                    }
                }
            }
        }
    ],
    "config": {}
