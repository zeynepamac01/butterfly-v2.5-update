      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "tree",
          "method": {
            "signal": "layout"
          },
          "size": [
            {
              "signal": "height * 0.75"
            },
            {
              "signal": "width * 0.88"
            }
          ],
          "as": [
            "x",
            "y",
            "depth",
            "children"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.y + xShift",
          "as": "x_draw"
        },
        {
          "type": "formula",
          "expr": "datum.x",
          "as": "y_draw"
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {
          "type": "treelinks"
        },
        {
          "type": "linkpath",
          "shape": {
            "signal": "links"
          },
          "orient": "horizontal",
          "sourceX": "source.x_draw",
          "sourceY": "source.y_draw",
          "targetX": "target.x_draw",
          "targetY": "target.y_draw"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "stroke": {
            "value": "#ccc"
          },
          "opacity": {
            "value": 0.8
          },
          "strokeWidth": {
            "value": 0.75
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "size": {
            "value": 70
          },
          "stroke": {
            "value": "#fff"
          },
          "strokeWidth": {
            "value": 0.2
          }
        },
        "update": {
          "x": {
            "field": "x_draw"
          },
          "y": {
            "field": "y_draw"
          },
          "fill": {
            "field": "color"
          },
          "opacity": {
            "value": 0.7
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "text": {
            "field": "name"
          },
          "fontSize": {
            "value": 15
          },
          "font": {
            "value": "BentonSans"
          },
          "baseline": {
            "value": "bottom"
          }
        },
        "update": {
          "x": {
            "field": "x_draw"
          },
          "y": {
            "field": "y_draw"
          },
          "align": "left",
          "opacity": {
            "value": 1
          },
          "dx": {
            "value": 7
          },
          "dy": {
            "value": -4
          }
        }
      }
    }
  ],
  "config": {}
}