{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "An example of a radial layout for a node-link diagram of hierarchical data.",
  "width": 3000,
  "height": 1200,
  "padding": 0,
  "autosize": "none",
  "signals": [
    {"name": "xShift", "value": 80},
    {"name": "labels", "value": true, "bind": {"input": "checkbox"}},
    {
      "name": "layout",
      "value": "cluster",
      "bind": {"input": "radio", "options": ["tidy", "cluster"]}
    },
    {
      "name": "links",
      "value": "diagonal",
      "bind": {
        "input": "select",
        "options": ["line", "curve", "diagonal", "orthogonal"]
      }
    }
  ],
  "data": [
    {
      "name": "tree",
      "values": [
        {
          "id": 0,
          "name": "Body",
          "type": "AS",
          "ontology_id": "UBERON:0013702",
          "color": "#984ea3",
          "organ": "body",
          "organ_label": "",
          "alpha": 0.511211774098372,
          "depth": 0,
          "children": 21,
          "x": 860,
          "y": 860
        },
        {
          "id": 1,
          "name": "Respiratory System",
          "parent": 0,
          "type": "AS",
          "ontology_id": "UBERON:0001004",
          "color": "#984ea3",
          "organ": "lung",
          "organ_label": "Respiratory System",
          "alpha": 0.0357527161650873,
          "depth": 1,
          "children": 2,
          "x": 864.8203992162016,
          "y": 814.729599286517
        },
        {
          "id": 2,
          "name": "respiratory tract",
          "parent": 1,
          "type": "AS",
          "ontology_id": "UBERON:0000065",
          "color": "#984ea3",
          "organ": "lung",
          "organ_label": "",
          "alpha": 0.02787323405880107,
          "depth": 2,
          "children": 1,
          "x": 867.5216128716223,
          "y": 769.2585703371334
        }

      ],
      "transform": [
        {"type": "stratify", "key": "id", "parentKey": "parent"},
        {
          "type": "tree",
          "method": {"signal": "layout"},
          "size": [{"signal": "height * 0.20"}, {"signal": "width * 0.25"}],
          "as": ["x", "y", "depth", "children"]
        },
        {
          "type": "formula",
          "expr": "datum.y + xShift",
          "as": "x_draw"
        },
        {
          "type": "formula",
          "expr": "datum.x",
          "as": "y_draw"
}
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {"type": "treelinks"},
        {
          "type": "linkpath",
          "shape": {"signal": "links"},
          "orient": "horizontal",
          "sourceX": "source.x_draw",
          "sourceY": "source.y_draw",
          "targetX": "target.x_draw",
          "targetY": "target.y_draw"
}
      ]
    }
  ],
  "marks": [
    {
  "type": "path",
  "from": {"data": "links"},
  "encode": {
    "update": {
      "path": {"field": "path"},
      "stroke": {"value": "#ccc"},
      "opacity": {"value": 0.8},
      "strokeWidth": {"value": 0.75}
    }
  }
},
    {
      "type": "symbol",
      "from": {"data": "tree"},
      "encode": {
        "enter": {
          "size": {"value": 20},
          "stroke": {"value": "#fff"},
          "strokeWidth": {"value": 0.2}
        },
        "update": {
          "x": {"field": "x_draw"},
          "y": {"field": "y_draw"},
          "fill": {"field": "color"},
          "opacity": {"value": 0.7}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "tree"},
      "encode": {
        "enter": {
          "text": {"field": "name"},
          "fontSize": {"value": 8},
          "font": {"value": "BentonSans"},
          "baseline": {"value": "middle"}
        },
        "update": {  
        "x": {"field": "x_draw"},
        "y": {"field": "y_draw"},
        "align": "left",
        "opacity": {"field": "show_label"}
        }
      }
    }
  ],
  "config": {}
}